{
  "name": "msgdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-aware communication sandbox for local development and CI.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "mocks"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node apps/core/dist/cli.js",
    "build": "tsc -b --force && npm run build:client --workspace @msgdock/web",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
